<?xml version="1.0"?>
<package format="2">
  <name>patrol_navigation_rviz_plugin</name>
  <version>1.0.0</version>
  <description>
    A RViz plugin for multi-point patrol navigation with path planning, 
    cyclic inspection, and status monitoring capabilities.
  </description>

  <maintainer email="your-email@example.com">Your Name</maintainer>
  <license>BSD</license>

  <author email="your-email@example.com">Your Name</author>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- 主要依赖 -->
  <depend>rviz</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>actionlib_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>pluginlib</depend>

  <!-- Qt依赖 -->
  <build_depend>qtbase5-dev</build_depend>
  <exec_depend>libqt5-widgets</exec_depend>

  <!-- 导出 -->
  <export>
    <rviz plugin="${prefix}/patrol_navigation_plugin.xml" />
  </export>
</package>
